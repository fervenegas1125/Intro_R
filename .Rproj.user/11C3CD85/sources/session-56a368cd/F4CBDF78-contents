  library(dplyr)

datos <- tibble(
  especie = c("A", "A", "A", "A", "B", "B", "B", "B"),
  tratamiento = c("Control", "Control", "Tratado", "Tratado",
                  "Control", "Control", "Tratado", "Tratado"),
  valor = c(10, 20, 30, 40, 50, 60, 70, 80)
)

datos

resumen1 <- datos %>%
  group_by(especie, tratamiento) %>%
  summarise(promedio = mean(valor))

resumen1


group_vars(resumen1)


resumen1 %>% summarise(media = mean(promedio)) #Hace las medias sin importar el tratamiento 



resumen2 <- datos %>%
  group_by(especie, tratamiento) %>%
  summarise(promedio = mean(valor), 
            .groups ="drop") #Ya no existen los grupos en este punto.
resumen2

group_vars(resumen2) #No se verán más grupos
resumen2 $>$ summarise(media ==mean(promedio)) #Lo hizo con todo

#ungroup viene de una libreria, .group drop es de summarise.

