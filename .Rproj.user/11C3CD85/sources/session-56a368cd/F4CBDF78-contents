library(readr)
library(dplyr)
library(tidyr)
library(tibble)

#Leer blast y conteos
ruta_blast <- "data_raw/datos_sesion_02_blast/resultados_blast.tsv"
ruta_conteos <- "data_raw/datos_sesion_03_dplyr/conteos_genes.csv"

blast <- read_tsv(ruta_blast)
conteos <- read_csv(ruta_conteos)

glimpse(conteos) #Todas las caracteristicas de los archivos vistos ahi
class(blast) #clases del objeto

class(as.data.frame(blast)) #convertirlo a data.frame


----------------------------------------
--------------------------------------
#Otras funciones:

%>% #operadores como los pipelines
  
blast %>%
  select(query_id, subject_id, pident) #Seleccionar 3 columnas

blast %>%
  select(-evalue) #todas menos evalue
blast %>%
  select(starts_with("query")) #buscar que empiece con eso




starts_with() #buscar lo que empiece con algo


#Para usar los filtros (filter), podemos meterle condiciones y concatenar
blast %>%
  filter(pident >=90)

blast %>%
  filter(pident >=90, length >= 150) # & y , funcionan del mismo modo
blast %>%
  filter(query_id == "seq01" | query_id == "seq02") #Igual a esto o aquello

blast %>%
  filter(query_id == "seq01" | query_id == "seq03")

blast %>%
  filter(query_id %in% c("seq01", "seq02", "seq05")) #que el query coincida con cualquiera de estos

#Arrange (ordenar)
blast %>%
  arrange(length) #De menor a mayor

blast %>%
  arrange(desc(length)) #de mayor a menor

blast %>%
  arrange(query_id) #orden alfabético

blast %>%
  arrange(query_id, desc(bitscore)) #Ordena con respecto a una u otra

#rename
blast %>%
  rename("Porcentaje_identidad" =pident,
         "Longitud_alineamiento"=legth) 

# distinct: distingue las columnas, encuentra valores unicos
blast %>%
  distinct(query_id) #Busca todos los que son diferentes

blast %>%
  distinct(query_id, subject_id) #identifica cuales son diferentes, si dos son iguales en una columna, pero en la otra son distintas, las reporta

#Mutate
blast%>%
  mutate(proporcion_identidad = pident /100,
         longitud_kb =length/1000) %>% #Agrega columnas
  select(query_id, pident, proporcion_identidad, longitud_kb)


blast%>%
  mutate(supera_90 = pident >= 90,
         etiqueta = if_else(pident >=90, "90 o más", "Menos de 90")) %>%
  select(query_id, pident, supera_90, etiqueta)

#case_when

blast %>%
  mutate(grupo_didactico= case_when(
    pident>=95 ~"Grupo A",
    pident >= 80 ~ "Grupo B",
    TRUE ~ "Grupo C"
  )
  ) %>%
  count(grupo_didactico)


blast %>%
  count(query_id, sort = TRUE) #ordena de mayor a menor


#group_by y summarise

resumen <- blast %>%
  group_by(query_id) %>%
  summarise( numero_alineamiento =n(),
             referencias_distintas = n_distinct(subject_id),
             bitscore_maximo = max(bitscore),
             identidad_promedio = mean(pident),
             .groups ="drop")
resumen


blast %>%
  group_by(query_id) %>%
  mutate(
    alineamientos_por_consulta = n()
    ) %>%
  ungroup() $>$
  select(query_id, subject_id, alineamientos_por_consulta)



conteos_largos <- conteos %>%
  pivot_longer( cols = starts_with("muestra"),
                names_to ="muestra",
                values_to = "conteos")
conteos_largos #Crear nuevas columnas, tomando nuevos nombres de columna y ciertos números


conteos_recuperados <- conteos_largos %>%
  pivot_wider(names_from = muestra,
              values_from = conteos)
conteos_recuperados

